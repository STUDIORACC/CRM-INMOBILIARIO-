# ============================================================================
# CRM Inmobiliario · variables de entorno
# Copia este archivo a .env.local y completa los valores.
#
# SIN configurar nada la app arranca en MODO DEMO (Postgres embebido con datos
# de ejemplo). Para producción conecta tu proyecto de Supabase:
# ============================================================================

# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor: alta de usuarios y almacenamiento de archivos. NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Base de datos (Settings > Database > Connection string) ---
# Usa el "Transaction pooler" (puerto 6543) si despliegas en Vercel.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- App ---
NEXT_PUBLIC_TIMEZONE=America/Lima
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=51
# Protege /api/cron/alerts (Vercel Cron la envía como "Authorization: Bearer <valor>")
CRON_SECRET=cambia-este-valor

# --- Solo modo demo (sin DATABASE_URL) ---
# DEMO_SESSION_SECRET=cambia-este-valor-largo-y-aleatorio
# DEMO_IN_MEMORY=1        # no persiste los datos en .data/
